# PostgreSQL Database Connection String
# Example: postgresql://username:password@localhost:5432/taskflow
DATABASE_URL=

# Database Connection Pool Maximum Connections (default: 10)
DATABASE_POOL_MAX=10

# Secret key for HMAC-SHA256 signing of access tokens (minimum 32 characters)
AUTH_SECRET=

# API Rate Limit (maximum requests per minute per IP, default: 60)
API_RATE_LIMIT_MAX=60

# Node Environment
NODE_ENV=development
