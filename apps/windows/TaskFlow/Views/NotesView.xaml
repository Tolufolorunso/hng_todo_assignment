<UserControl x:Class="TaskFlow.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TaskFlow.ViewModels"
             xmlns:controls="clr-namespace:TaskFlow.Controls"
             d:DataContext="{d:DesignInstance vm:NotesViewModel}"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- LEFT PANE: Notes Master List, Search & Quick Create Drawer    -->
        <!-- ============================================================== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Notes" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="{DynamicResource BgSurfaceElevated}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NotesCountLabel}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </StackPanel>

                <Button Content="+ New Note"
                        Style="{DynamicResource ModernButton}"
                        Command="{Binding OpenCreatePanelCommand}"
                        HorizontalAlignment="Right"
                        Padding="12,6"
                        FontSize="12"
                        AutomationProperties.Name="Create new note" />
            </Grid>

            <!-- Search Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <TextBox x:Name="NotesSearchInput"
                         Style="{DynamicResource ModernTextBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8,28,8"
                         AutomationProperties.Name="Search notes" />
                <TextBlock Text="Search notes..."
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=NotesSearchInput}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Command="{Binding ClearSearchCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Padding="4,2"
                        FontSize="10"
                        AutomationProperties.Name="Clear search"
                        ToolTip="Clear search">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="✕" FontSize="9" />
                </Button>
            </Grid>

            <!-- Create Note Drawer -->
            <Border Grid.Row="2"
                    Visibility="{Binding IsCreatePanelVisible, Converter={StaticResource BoolToVis}}"
                    Style="{DynamicResource ModernCard}"
                    Padding="14"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="New Note" Style="{DynamicResource CardTitleText}" Margin="0,0,0,10" />

                    <!-- Title Input -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Title *" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                        <Grid>
                            <TextBox x:Name="DrawerNoteTitleInput"
                                     Style="{DynamicResource ModernTextBox}"
                                     Text="{Binding NewNoteTitle, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New note title input" />
                            <TextBlock Text="e.g. Architecture decisions"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=DrawerNoteTitleInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Body Input -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Content" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                        <controls:WysiwygEditorControl HtmlText="{Binding NewNoteBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Placeholder="Write note thoughts, ideas, or meeting notes..."
                                                       MinEditorHeight="100" />
                    </StackPanel>

                    <!-- Drawer Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding CloseCreatePanelCommand}"
                                Margin="0,0,8,0"
                                Padding="10,4"
                                FontSize="11"
                                AutomationProperties.Name="Cancel note creation" />
                        <Button Content="Create Note"
                                Style="{DynamicResource ModernButton}"
                                Command="{Binding CreateNoteCommand}"
                                Padding="12,4"
                                FontSize="11"
                                AutomationProperties.Name="Save new note" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Notes List / Cards -->
            <Grid Grid.Row="3">
                <ListBox ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNoteViewModel, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Notes list">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,0,0,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Cursor="Hand"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,12"
                                    MouseDown="OnNoteCardMouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
                                                <Setter Property="Background" Value="{DynamicResource BgSurfaceElevated}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderMuted}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Title & Quick Reader Button -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{DynamicResource SecondaryButton}"
                                                Command="{Binding DataContext.OpenReaderModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2"
                                                Margin="6,0,0,0"
                                                ToolTip="Open in Document Reader"
                                                AutomationProperties.Name="Open document reader">
                                            <TextBlock Text="📖 Read" FontSize="10" />
                                        </Button>
                                    </Grid>

                                    <!-- Excerpt Preview -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Excerpt}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               MaxHeight="34"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,8" />

                                    <!-- Metadata Row -->
                                    <Grid Grid.Row="2">
                                        <Border Background="{DynamicResource BgSurfaceElevated}"
                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="6,1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedReadingStats}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Border>

                                        <TextBlock Text="{Binding FormattedUpdatedAt}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <Border
                        Padding="24"
                        VerticalAlignment="Top"
                        Margin="0,12,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📝" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="No notes found" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Create a note or adjust search query." FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- RIGHT PANE: Note Editor & Document Reader                      -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1">
            <!-- Placeholder when no note is selected and create panel is closed -->
            <Border
                    Padding="36"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSelectedNote}" Value="False" />
                                    <Condition Binding="{Binding IsCreatePanelVisible}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="No Note Selected" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Select a note from the list or create a new note to start editing or reading." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,14" />
                    <Button Content="+ New Note" Style="{DynamicResource ModernButton}" Command="{Binding OpenCreatePanelCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Active Note Card Container -->
            <Border Visibility="{Binding HasSelectedNote, Converter={StaticResource BoolToVis}}"
                    Style="{DynamicResource ModernCard}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Mode Switch & Action Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <!-- Editor Mode Button -->
                            <Button Content="✏️ Editor"
                                    Command="{Binding OpenEditorModeCommand}"
                                    Margin="0,0,6,0"
                                    Padding="10,4"
                                    FontSize="11"
                                    AutomationProperties.Name="Switch to editor mode">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditorMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BgPrimary}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Document Reader Mode Button -->
                            <Button Content="📖 Document Reader"
                                    Command="{Binding OpenReaderModeCommand}"
                                    Padding="10,4"
                                    FontSize="11"
                                    AutomationProperties.Name="Switch to document reader mode">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReaderMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BgPrimary}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Right Actions for Editor Mode -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVis}}">
                            <Border Background="{DynamicResource BgSurfaceElevated}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormattedReadingStats}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            </Border>

                            <Button Content="Delete Note"
                                    Style="{DynamicResource DangerButton}"
                                    Command="{Binding DeleteNoteCommand}"
                                    Margin="0,0,8,0"
                                    Padding="10,5"
                                    FontSize="11"
                                    AutomationProperties.Name="Delete active note" />

                            <Button Content="Save Changes"
                                    Style="{DynamicResource ModernButton}"
                                    Command="{Binding SaveSelectedNoteCommand}"
                                    Padding="14,5"
                                    FontSize="11"
                                    AutomationProperties.Name="Save active note changes" />
                        </StackPanel>

                        <!-- Right Actions for Document Reader Mode -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsReaderMode, Converter={StaticResource BoolToVis}}">
                            <Button Content="📋 Copy Text"
                                    Style="{DynamicResource SecondaryButton}"
                                    Command="{Binding CopyNoteBodyCommand}"
                                    Margin="0,0,8,0"
                                    Padding="10,5"
                                    FontSize="11"
                                    ToolTip="Copy title and plain text to clipboard"
                                    AutomationProperties.Name="Copy note plain text" />

                            <Button Content="🖨️ Print"
                                    Style="{DynamicResource SecondaryButton}"
                                    Click="OnPrintClick"
                                    Margin="0,0,8,0"
                                    Padding="10,5"
                                    FontSize="11"
                                    ToolTip="Print document"
                                    AutomationProperties.Name="Print note document" />

                            <Button Content="✏️ Edit Note"
                                    Style="{DynamicResource ModernButton}"
                                    Command="{Binding OpenEditorModeCommand}"
                                    Padding="12,5"
                                    FontSize="11"
                                    AutomationProperties.Name="Edit note in editor" />
                        </StackPanel>
                    </Grid>

                    <!-- ====================================================== -->
                    <!-- VIEW 1: Editor View                                    -->
                    <!-- ====================================================== -->
                    <Grid Grid.Row="1" Visibility="{Binding IsEditorMode, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Title Input -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Note Title" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Style="{DynamicResource ModernTextBox}"
                                     Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     AutomationProperties.Name="Selected note title editor" />
                        </StackPanel>

                        <!-- Content Wysiwyg Editor -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Content (Rich Text)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <controls:WysiwygEditorControl Grid.Row="1"
                                                           HtmlText="{Binding SelectedNote.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Placeholder="Write your rich document here..."
                                                           MinEditorHeight="280" />
                        </Grid>
                    </Grid>

                    <!-- ====================================================== -->
                    <!-- VIEW 2: Document Reader View                           -->
                    <!-- ====================================================== -->
                    <ScrollViewer Grid.Row="1"
                                  Visibility="{Binding IsReaderMode, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,0,16,16">
                            <!-- Document Header -->
                            <TextBlock Text="{Binding SelectedNote.Title}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="Last updated " FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding FormattedUpdatedAt}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0" />
                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BorderSubtle}" Margin="0,0,10,0" />
                                <Border Background="{DynamicResource BgSurfaceElevated}"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FormattedReadingStats}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </StackPanel>

                            <Border Background="{DynamicResource BorderSubtle}" Height="1" Margin="0,0,0,18" />

                            <!-- Actionable Extraction Banner -->
                            <Border Background="{DynamicResource BgSurfaceElevated}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="⚡ Actionable Excerpt (Convert to Task or Follow-Up)"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,6" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Style="{DynamicResource ModernTextBox}"
                                                 Text="{Binding ActionableExcerpt, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0"
                                                 AutomationProperties.Name="Actionable excerpt input" />

                                        <Button Grid.Column="1"
                                                Content="+ Task"
                                                Style="{DynamicResource SecondaryButton}"
                                                Command="{Binding CreateTaskFromExcerptCommand}"
                                                Margin="0,0,6,0"
                                                Padding="10,4"
                                                FontSize="11"
                                                ToolTip="Create linked task from excerpt"
                                                AutomationProperties.Name="Create task from note excerpt" />

                                        <Button Grid.Column="2"
                                                Content="+ Follow-Up"
                                                Style="{DynamicResource SecondaryButton}"
                                                Command="{Binding CreateFollowUpFromExcerptCommand}"
                                                Padding="10,4"
                                                FontSize="11"
                                                ToolTip="Create linked follow-up from excerpt"
                                                AutomationProperties.Name="Create follow-up from note excerpt" />
                                    </Grid>

                                    <!-- Feedback Banner -->
                                    <TextBlock Text="{Binding ActionableSuccessMessage}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentGreen}"
                                               Visibility="{Binding HasActionableSuccessMessage, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <!-- Document Body Rendered Cleanly -->
                            <controls:FormattedTextRendererControl HtmlText="{Binding SelectedNote.Body}"
                                                                   EmptyPlaceholder="(Empty note body)"
                                                                   Margin="0,0,0,24" />

                            <!-- Linked Actions (Backlinks) Section -->
                            <StackPanel Visibility="{Binding HasLinkedActions, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                <Border Background="{DynamicResource BorderSubtle}" Height="1" Margin="0,0,0,16" />
                                <TextBlock Text="Linked Actions" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

                                <!-- Linked Tasks List -->
                                <StackPanel Visibility="{Binding HasLinkedTasks, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                    <TextBlock Text="Tasks" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding LinkedTasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{DynamicResource ModernCard}" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{Binding Completed, Mode=OneWay}"
                                                                  Command="{Binding DataContext.ToggleLinkedTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"
                                                                  Style="{DynamicResource ModernCheckBox}"
                                                                  Margin="0,0,8,0"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Toggle linked task completion" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Border Grid.Column="2"
                                                                Background="{DynamicResource BgSurfaceElevated}"
                                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PriorityLabel}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Linked Follow-Ups List -->
                                <StackPanel Visibility="{Binding HasLinkedFollowUps, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Follow-Ups" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding LinkedFollowUps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{DynamicResource ModernCard}" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding PersonName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                            <TextBlock Text="{Binding Commitment}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Background="{DynamicResource BgSurfaceElevated}"
                                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
