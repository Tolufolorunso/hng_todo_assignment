<UserControl x:Class="TaskFlow.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TaskFlow.ViewModels"
             d:DataContext="{d:DesignInstance vm:CalendarViewModel}"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- Calendar Month Nav -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="&lt;" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousMonthCommand}" Padding="10,4" Margin="0,0,6,0" AutomationProperties.Name="Previous month" />
                <Button Content="&gt;" Style="{StaticResource SecondaryButton}" Command="{Binding NextMonthCommand}" Padding="10,4" Margin="0,0,10,0" AutomationProperties.Name="Next month" />
                <TextBlock Text="{Binding MonthDisplay}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="Today" Style="{StaticResource SecondaryButton}" Command="{Binding TodayCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Jump to today" />
        </Grid>

        <!-- Monthly 42-cell UniformGrid -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="8" Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="3">
                            <Border x:Name="dayCellBorder"
                                    CornerRadius="6"
                                    Background="{DynamicResource BgSurfaceElevated}"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Padding="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BgSurface}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <!-- Day Number and Today Badge Header -->
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource AccentBlue}"
                                                CornerRadius="3"
                                                Padding="4,1"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="Today" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <!-- Dual Task and Follow-up Badges -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- Tasks Due Badge (Blue) -->
                                        <Border Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource AccentBlue}"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                Margin="0,0,4,0">
                                            <TextBlock Text="{Binding TaskCount, StringFormat='{}{0} task'}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                        <!-- Follow-ups Due Badge (Amber) -->
                                        <Border Visibility="{Binding HasFollowUps, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource AccentAmber}"
                                                CornerRadius="4"
                                                Padding="4,1">
                                            <TextBlock Text="{Binding FollowUpCount, StringFormat='{}{0} follow-up'}" FontSize="10" Foreground="Black" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Day Inspector -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding SelectedDateDisplay}" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedDayItems}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Selected day items">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="• " Foreground="{DynamicResource AccentBlue}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding Explanation, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>

