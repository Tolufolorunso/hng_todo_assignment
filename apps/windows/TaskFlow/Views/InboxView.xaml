<UserControl x:Class="TaskFlow.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TaskFlow.ViewModels"
             d:DataContext="{d:DesignInstance vm:InboxViewModel}"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fast Capture Header Box -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Fast Capture Inbox" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                <TextBlock Text="Quickly drop thoughts, URLs, or snippets to triage into tasks, notes, or follow-ups." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox x:Name="QuickCaptureTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding FastCaptureText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="42"
                                 Padding="12,0"
                                 FontSize="13"
                                 AutomationProperties.Name="Fast capture text box" />
                        <TextBlock Text="Paste any text or link here..."
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QuickCaptureTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1"
                            Content="⚡ Capture"
                            Style="{StaticResource ModernButton}"
                            Height="42"
                            Command="{Binding CaptureCommand}"
                            AutomationProperties.Name="Execute fast capture" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Filter and Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- State Filter Tabs -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Pending Tab -->
                <Button Style="{DynamicResource SecondaryButton}"
                        Command="{Binding SetFilterStateCommand}"
                        CommandParameter="pending"
                        Margin="0,0,6,0"
                        Padding="12,6"
                        AutomationProperties.Name="Filter pending captures">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pending" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource PriorityMediumBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding PendingCount}" FontSize="11" Foreground="Black" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- Processed Tab -->
                <Button Style="{DynamicResource SecondaryButton}"
                        Command="{Binding SetFilterStateCommand}"
                        CommandParameter="processed"
                        Margin="0,0,6,0"
                        Padding="12,6"
                        AutomationProperties.Name="Filter processed captures">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Processed" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding ProcessedCount}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        </Border>
                    </StackPanel>
                </Button>

                <!-- All Tab -->
                <Button Content="All"
                        Style="{DynamicResource SecondaryButton}"
                        Command="{Binding SetFilterStateCommand}"
                        CommandParameter="all"
                        Padding="12,6"
                        AutomationProperties.Name="Filter all captures" />
            </StackPanel>

            <!-- Search Input -->
            <Grid Grid.Column="1" HorizontalAlignment="Right" Width="220">
                <TextBox x:Name="SearchInboxBox"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Height="34"
                         Padding="10,0"
                         AutomationProperties.Name="Search inbox" />
                <TextBlock Text="Search captures..."
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchInboxBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Captures List & 1-Click Triage -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding FilteredCaptures}"
                 SelectedItem="{Binding SelectedCapture}"
                 Background="Transparent"
                 BorderThickness="0"
                 AutomationProperties.Name="Inbox captures list">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,0,0,10" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ModernCard}" Padding="16,14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Details, URL, and Status Header -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- Status Badge and Timestamp -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding State, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="{Binding StateBadgeColor}" />
                                    </Border>
                                    <TextBlock Text="{Binding FormattedCapturedAt}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Text Content -->
                                <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,6" />

                                <!-- URL Link Button (if present) -->
                                <Button Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.LaunchUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding SharedUrl}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Padding="8,2"
                                        FontSize="11"
                                        AutomationProperties.Name="Open shared url link">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔗 " FontSize="10" />
                                        <TextBlock Text="{Binding SharedUrl}" Foreground="{DynamicResource AccentBlue}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Right: 1-Click Triage Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Convert to Task -->
                                <Button Content="→ Task"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.TriageToTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Triage capture to task" />

                                <!-- Convert to Note -->
                                <Button Content="→ Note"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.TriageToNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Triage capture to note" />

                                <!-- Convert to Follow-Up -->
                                <Button Content="→ Follow-Up"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,5"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.TriageToFollowUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Triage capture to follow-up" />

                                <!-- Discard Button -->
                                <Button Content="Discard"
                                        Style="{StaticResource DangerButton}"
                                        Padding="8,5"
                                        FontSize="11"
                                        Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Discard capture" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
