<UserControl x:Class="TaskFlow.Views.FollowUpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TaskFlow.ViewModels"
             d:DataContext="{d:DesignInstance vm:FollowUpsViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- Main Content ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,22,28,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: Follow Ups + New Follow Up Button -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Follow Ups"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" />

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="+ New Follow Up"
                            Style="{DynamicResource ModernButton}"
                            Command="{Binding OpenCreatePanelCommand}"
                            Padding="16,8"
                            FontSize="13"
                            AutomationProperties.Name="Open New Follow Up dialog" />
                </Grid>

                <!-- Subtitle -->
                <TextBlock Grid.Row="1"
                           Text="Manage commitments to people, recurring check-ins, and direct communication launchers."
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,24" />

                <!-- Filter Tabs and Search Bar -->
                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status Filter Tabs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding AllCountText}"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding SetStatusFilterCommand}"
                                CommandParameter="all"
                                Margin="0,0,6,0"
                                Padding="14,6"
                                FontSize="12"
                                AutomationProperties.Name="Filter all follow-ups" />

                        <Button Content="{Binding DueOverdueCountText}"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding SetStatusFilterCommand}"
                                CommandParameter="due_overdue"
                                Margin="0,0,6,0"
                                Padding="14,6"
                                FontSize="12"
                                AutomationProperties.Name="Filter due and overdue follow-ups" />

                        <Button Content="{Binding UpcomingCountText}"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding SetStatusFilterCommand}"
                                CommandParameter="upcoming"
                                Margin="0,0,6,0"
                                Padding="14,6"
                                FontSize="12"
                                AutomationProperties.Name="Filter upcoming follow-ups" />

                        <Button Content="{Binding CompletedCountText}"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding SetStatusFilterCommand}"
                                CommandParameter="completed"
                                Padding="14,6"
                                FontSize="12"
                                AutomationProperties.Name="Filter completed follow-ups" />
                    </StackPanel>

                    <!-- Right: Search Input -->
                    <Grid Grid.Column="1" Width="260">
                        <TextBox x:Name="SearchFollowUpsBox"
                                 Style="{DynamicResource ModernTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Padding="28,6,10,6"
                                 AutomationProperties.Name="Search follow ups" />
                        <TextBlock Text="🔍"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   IsHitTestVisible="False" />
                        <TextBlock Text="Search follow-ups..."
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="30,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchFollowUpsBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- Follow-up Cards List -->
                <Grid Grid.Row="3">
                    <!-- Empty State -->
                    <Border Padding="36"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="400">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredFollowUps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👥" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="No follow-ups found" Style="{DynamicResource CardTitleText}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="Create a follow-up commitment with the button above, or clear your search and filters."
                                       Style="{DynamicResource CardSubtitleText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Items List -->
                    <ListBox ItemsSource="{Binding FilteredFollowUps}"
                             SelectedItem="{Binding SelectedFollowUp}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Follow-ups list">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,10" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FollowUpItemViewModel}">
                                <Border Style="{DynamicResource ModernCard}"
                                        Margin="0,0,0,12"
                                        Padding="18,16"
                                        AutomationProperties.Name="{Binding PersonName}">
                                    <StackPanel>
                                        <!-- Top Row: CheckBox + Person Name + Action Toolbar -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- CheckBox -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                      Command="{Binding DataContext.CompleteOccurrenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      AutomationProperties.Name="Complete follow-up occurrence" />

                                            <!-- Person Name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PersonName}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Action Toolbar: History, Calendar, Snooze, Edit, Delete -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="⏱"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Padding="7,4"
                                                        FontSize="11"
                                                        Margin="0,0,5,0"
                                                        Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="View occurrence history"
                                                        AutomationProperties.Name="View occurrence history" />

                                                <Button Content="📅"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Padding="7,4"
                                                        FontSize="11"
                                                        Margin="0,0,5,0"
                                                        Command="{Binding DataContext.OpenRescheduleModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Reschedule commitment"
                                                        AutomationProperties.Name="Reschedule follow-up" />

                                                <Button Content="🕒"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Padding="7,4"
                                                        FontSize="11"
                                                        Margin="0,0,5,0"
                                                        Command="{Binding DataContext.SnoozeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Snooze 24 hours"
                                                        AutomationProperties.Name="Snooze follow-up" />

                                                <Button Content="✎"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Padding="7,4"
                                                        FontSize="11"
                                                        Margin="0,0,5,0"
                                                        Command="{Binding DataContext.OpenEditPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Edit follow-up"
                                                        AutomationProperties.Name="Edit follow-up" />

                                                <Button Content="🗑"
                                                        Style="{DynamicResource DangerButton}"
                                                        Padding="7,4"
                                                        FontSize="11"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Delete follow-up"
                                                        AutomationProperties.Name="Delete follow-up" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Commitment Title -->
                                        <TextBlock Text="{Binding Commitment}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   Margin="30,0,0,3" />

                                        <!-- Details (if present) -->
                                        <TextBlock Text="{Binding Details}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="30,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDetails}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Due Date and Communication Launchers Row -->
                                        <StackPanel Margin="30,0,0,0">
                                            <!-- Due Date Display -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="🕒 " FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding WebFormattedDueAt}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentRose}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Communication Launchers -->
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Email Launcher -->
                                                <Button Style="{DynamicResource SecondaryButton}"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.LaunchEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Send Email">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="✉ Email" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- WhatsApp Launcher -->
                                                <Button Style="{DynamicResource SecondaryButton}"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.LaunchWhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Send WhatsApp message">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💬 WhatsApp" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Call Launcher -->
                                                <Button Style="{DynamicResource SecondaryButton}"
                                                        Padding="10,4"
                                                        Command="{Binding DataContext.LaunchPhoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Call phone">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📞 Call" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- CENTERED NEW / EDIT FOLLOW UP MODAL OVERLAY -->
        <Grid Background="#99000000"
              Visibility="{Binding IsCreatePanelVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource ModernCard}"
                    Background="{DynamicResource BgSurfaceElevated}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="520"
                    MaxHeight="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="New Follow Up"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />

                        <Button Content="✕"
                                Style="{DynamicResource SecondaryButton}"
                                Padding="8,4"
                                FontSize="12"
                                Command="{Binding ClosePanelsCommand}"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Close follow-up modal" />
                    </Grid>

                    <!-- Form Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- PERSON OR CONTACT * -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="PERSON OR CONTACT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text=" *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentRose}" />
                                </StackPanel>
                                <TextBox Style="{DynamicResource ModernTextBox}"
                                         Text="{Binding PersonName, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         Padding="12,8"
                                         FontSize="13"
                                         AutomationProperties.Name="Contact person name" />
                            </StackPanel>

                            <!-- COMMITMENT / FOLLOW UP * -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="COMMITMENT / FOLLOW UP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text=" *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentRose}" />
                                </StackPanel>
                                <Grid>
                                    <TextBox x:Name="CommitmentInputBox"
                                             Style="{DynamicResource ModernTextBox}"
                                             Text="{Binding Commitment, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38"
                                             Padding="12,8"
                                             FontSize="13"
                                             AutomationProperties.Name="Commitment title" />
                                    <TextBlock Text="e.g. Send updated budget proposal, review draft"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=CommitmentInputBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!-- DUE DATE & TIME * -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="DUE DATE &amp; TIME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text=" *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentRose}" />
                                </StackPanel>
                                <Grid>
                                    <TextBox x:Name="DueAtInputBox"
                                             Style="{DynamicResource ModernTextBox}"
                                             Text="{Binding DueAt, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38"
                                             Padding="12,8,36,8"
                                             FontSize="13"
                                             AutomationProperties.Name="Due date and time" />
                                    <TextBlock Text="📅"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               IsHitTestVisible="False" />
                                    <TextBlock Text="29/10/2026 05:53 pm"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DueAtInputBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!-- DETAILS & CONTEXT -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="DETAILS &amp; CONTEXT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5" />
                                <Grid>
                                    <TextBox x:Name="DetailsInputBox"
                                             Style="{DynamicResource ModernTextBox}"
                                             Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                                             Height="80"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Padding="12,8"
                                             FontSize="13"
                                             AutomationProperties.Name="Follow up details and context" />
                                    <TextBlock Text="Include background context, links, or discussion notes..."
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="12"
                                               VerticalAlignment="Top"
                                               Margin="14,10,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DetailsInputBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!-- COMMUNICATION LAUNCHERS (OPTIONAL) BOX -->
                            <Border Style="{DynamicResource ModernCard}"
                                    Background="{DynamicResource BgSurface}"
                                    Padding="14"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="COMMUNICATION LAUNCHERS (OPTIONAL)"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Email -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                                            <TextBox Style="{DynamicResource ModernTextBox}"
                                                     Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34"
                                                     Padding="8,5"
                                                     FontSize="12"
                                                     AutomationProperties.Name="Email address" />
                                        </StackPanel>

                                        <!-- Phone -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Phone" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                                            <TextBox Style="{DynamicResource ModernTextBox}"
                                                     Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34"
                                                     Padding="8,5"
                                                     FontSize="12"
                                                     AutomationProperties.Name="Phone number" />
                                        </StackPanel>

                                        <!-- WhatsApp -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="WhatsApp" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                                            <TextBox Style="{DynamicResource ModernTextBox}"
                                                     Text="{Binding WhatsAppNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34"
                                                     Padding="8,5"
                                                     FontSize="12"
                                                     AutomationProperties.Name="WhatsApp number" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Preferred Action Launcher Dropdown -->
                                    <TextBlock Text="Preferred Action Launcher" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding PreferredActionOptions}"
                                              SelectedItem="{Binding PreferredAction}"
                                              Height="34"
                                              AutomationProperties.Name="Preferred action launcher" />
                                </StackPanel>
                            </Border>

                            <!-- RECURRING COMMITMENT CHECKBOX -->
                            <CheckBox IsChecked="{Binding IsRecurring}"
                                      Margin="0,0,0,6"
                                      AutomationProperties.Name="Toggle recurring commitment">
                                <TextBlock Text="RECURRING COMMITMENT"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </CheckBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding ClosePanelsCommand}"
                                Padding="16,8"
                                FontSize="13"
                                Margin="0,0,10,0"
                                AutomationProperties.Name="Cancel follow-up modal" />
                        <Button Content="Create Follow Up"
                                Style="{DynamicResource ModernButton}"
                                Command="{Binding CreateCommand}"
                                Padding="20,8"
                                FontSize="13"
                                AutomationProperties.Name="Confirm create follow-up" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- CENTERED EDIT FOLLOW UP MODAL OVERLAY -->
        <Grid Background="#99000000"
              Visibility="{Binding IsEditPanelVisible, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource ModernCard}"
                    Background="{DynamicResource BgSurfaceElevated}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="520"
                    MaxHeight="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Edit Follow Up"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />

                        <Button Content="✕"
                                Style="{DynamicResource SecondaryButton}"
                                Padding="8,4"
                                FontSize="12"
                                Command="{Binding ClosePanelsCommand}"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Close edit modal" />
                    </Grid>

                    <!-- Form Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- PERSON OR CONTACT * -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="PERSON OR CONTACT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text=" *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentRose}" />
                                </StackPanel>
                                <TextBox Style="{DynamicResource ModernTextBox}"
                                         Text="{Binding PersonName, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         Padding="12,8"
                                         FontSize="13"
                                         AutomationProperties.Name="Contact person name" />
                            </StackPanel>

                            <!-- COMMITMENT / FOLLOW UP * -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="COMMITMENT / FOLLOW UP" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text=" *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentRose}" />
                                </StackPanel>
                                <TextBox Style="{DynamicResource ModernTextBox}"
                                         Text="{Binding Commitment, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         Padding="12,8"
                                         FontSize="13"
                                         AutomationProperties.Name="Commitment title" />
                            </StackPanel>

                            <!-- DUE DATE & TIME * -->
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="DUE DATE &amp; TIME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text=" *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentRose}" />
                                </StackPanel>
                                <TextBox Style="{DynamicResource ModernTextBox}"
                                         Text="{Binding DueAt, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         Padding="12,8"
                                         FontSize="13"
                                         AutomationProperties.Name="Due date and time" />
                            </StackPanel>

                            <!-- DETAILS & CONTEXT -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="DETAILS &amp; CONTEXT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5" />
                                <TextBox Style="{DynamicResource ModernTextBox}"
                                         Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                                         Height="80"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Padding="12,8"
                                         FontSize="13"
                                         AutomationProperties.Name="Follow up details and context" />
                            </StackPanel>

                            <!-- COMMUNICATION LAUNCHERS (OPTIONAL) BOX -->
                            <Border Style="{DynamicResource ModernCard}"
                                    Background="{DynamicResource BgSurface}"
                                    Padding="14"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="COMMUNICATION LAUNCHERS (OPTIONAL)"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Email -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                                            <TextBox Style="{DynamicResource ModernTextBox}"
                                                     Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34"
                                                     Padding="8,5"
                                                     FontSize="12"
                                                     AutomationProperties.Name="Email address" />
                                        </StackPanel>

                                        <!-- Phone -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Phone" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                                            <TextBox Style="{DynamicResource ModernTextBox}"
                                                     Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34"
                                                     Padding="8,5"
                                                     FontSize="12"
                                                     AutomationProperties.Name="Phone number" />
                                        </StackPanel>

                                        <!-- WhatsApp -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="WhatsApp" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                                            <TextBox Style="{DynamicResource ModernTextBox}"
                                                     Text="{Binding WhatsAppNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="34"
                                                     Padding="8,5"
                                                     FontSize="12"
                                                     AutomationProperties.Name="WhatsApp number" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Preferred Action Launcher Dropdown -->
                                    <TextBlock Text="Preferred Action Launcher" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding PreferredActionOptions}"
                                              SelectedItem="{Binding PreferredAction}"
                                              Height="34"
                                              AutomationProperties.Name="Preferred action launcher" />
                                </StackPanel>
                            </Border>

                            <!-- RECURRING COMMITMENT CHECKBOX -->
                            <CheckBox IsChecked="{Binding IsRecurring}"
                                      Margin="0,0,0,6"
                                      AutomationProperties.Name="Toggle recurring commitment">
                                <TextBlock Text="RECURRING COMMITMENT"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </CheckBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Modal Footer -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding ClosePanelsCommand}"
                                Padding="16,8"
                                FontSize="13"
                                Margin="0,0,10,0"
                                AutomationProperties.Name="Cancel edit modal" />
                        <Button Content="Save Changes"
                                Style="{DynamicResource ModernButton}"
                                Command="{Binding SaveEditCommand}"
                                Padding="20,8"
                                FontSize="13"
                                AutomationProperties.Name="Save follow-up changes" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Reschedule Modal Overlay -->
        <Grid Visibility="{Binding IsRescheduleModalOpen, Converter={StaticResource BoolToVis}}" Background="#99000000">
            <Border Style="{DynamicResource ModernCard}"
                    Background="{DynamicResource BgSurfaceElevated}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="Reschedule Follow-Up" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                    <TextBlock Text="Set a new due date for this commitment:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />

                    <TextBox Style="{DynamicResource ModernTextBox}"
                             Text="{Binding RescheduleDueAt, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="10,6"
                             Margin="0,0,0,16"
                             AutomationProperties.Name="New due date" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding CloseRescheduleModalCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Cancel reschedule" />
                        <Button Content="Confirm Reschedule"
                                Style="{DynamicResource ModernButton}"
                                Command="{Binding RescheduleCommand}"
                                Padding="16,6"
                                AutomationProperties.Name="Confirm reschedule" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Occurrence History Modal Overlay -->
        <Grid Visibility="{Binding IsHistoryModalOpen, Converter={StaticResource BoolToVis}}" Background="#99000000">
            <Border Style="{DynamicResource ModernCard}"
                    Background="{DynamicResource BgSurfaceElevated}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="480"
                    MaxHeight="450"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Occurrence Completion History" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding SelectedFollowUp.PersonName, StringFormat='Past occurrences for {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding OccurrenceHistory}" Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ScheduledDueTime, StringFormat='Scheduled: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding ResolutionTime, StringFormat='Resolved: {0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource BgSurfaceElevated}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Outcome}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2"
                            Content="Close"
                            Style="{DynamicResource SecondaryButton}"
                            Command="{Binding CloseHistoryModalCommand}"
                            Padding="14,6"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Close occurrence history" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>