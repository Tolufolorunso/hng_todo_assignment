<Window x:Class="TaskFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskFlow"
        xmlns:vm="clr-namespace:TaskFlow.ViewModels"
        mc:Ignorable="d"
        Title="TaskFlow Desktop"
        Height="760" Width="1120"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Color Palette -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0B0F19" />
        <SolidColorBrush x:Key="BgSurface" Color="#151C2C" />
        <SolidColorBrush x:Key="BgSurfaceElevated" Color="#1E273A" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#232E42" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentBlueHover" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRose" Color="#EF4444" />

        <!-- Styles -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#232E42" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="Foreground" Value="#FEE2E2" />
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E273A" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A2234" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="CaretBrush" Value="#3B82F6" />
            <Setter Property="BorderBrush" Value="#2A374F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateToTasksCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateToNotesCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateToBackupCommand}" />
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{Binding NavigateToTasksCommand}" />
        <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding NavigateToNotesCommand}" />
        <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding NavigateToBackupCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding QuickCreateCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Space" Command="{Binding ToggleSelectedCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TaskFlow" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
                    <Border Background="#1E273A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                    </Border>
                </StackPanel>

                <!-- Global Search -->
                <Grid Grid.Column="1" HorizontalAlignment="Left" Width="420" Margin="10,0">
                    <TextBox x:Name="SearchInput"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,7" />
                    <TextBlock Text="Search tasks and notes (Ctrl+F)..."
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Action Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ New Item"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding QuickCreateCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Background="#111827" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="14,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Button Content="Tasks"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToTasksCommand}"
                                Margin="0,0,0,6" />
                        <Button Content="Notes"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToNotesCommand}"
                                Margin="0,0,0,6" />
                        <Button Content="Backup &amp; Restore"
                                Style="{StaticResource SidebarButton}"
                                Command="{Binding NavigateToBackupCommand}"
                                Margin="0,0,0,6" />
                    </StackPanel>

                    <!-- Keyboard Help Box -->
                    <Border Grid.Row="2" Background="#151C2C" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Keyboard Shortcuts" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                            <TextBlock Text="Ctrl+1: Tasks tab" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Ctrl+2: Notes tab" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Ctrl+3: Backup tab" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Ctrl+N: Quick create" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Ctrl+F: Focus search" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Space: Toggle complete" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Delete: Delete selected" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- WORK CONTENT CONTAINER -->
            <Grid Grid.Column="1" Background="{StaticResource BgPrimary}">

                <!-- ==================== TASKS VIEW ==================== -->
                <Grid Visibility="{Binding IsTasksTabActive, Converter={StaticResource BoolToVis}}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Status Filter Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="All"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TasksVM.SetStatusFilterCommand}"
                                    CommandParameter="all"
                                    Margin="0,0,6,0" />
                            <Button Content="Active"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TasksVM.SetStatusFilterCommand}"
                                    CommandParameter="active"
                                    Margin="0,0,6,0" />
                            <Button Content="Completed"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TasksVM.SetStatusFilterCommand}"
                                    CommandParameter="completed"
                                    Margin="0,0,16,0" />

                            <TextBlock Text="Category:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding TasksVM.Categories}"
                                      SelectedItem="{Binding TasksVM.CategoryFilter}"
                                      Width="120" Height="32"
                                      Background="#1A2234" Foreground="#F8FAFC" />
                        </StackPanel>

                        <!-- Add Task Action -->
                        <Button Grid.Column="2"
                                Content="+ Add Task"
                                Style="{StaticResource ModernButton}"
                                Command="{Binding TasksVM.OpenCreatePanelCommand}" />
                    </Grid>

                    <!-- Inline Create Task Form -->
                    <Border Grid.Row="1"
                            Visibility="{Binding TasksVM.IsCreatePanelVisible, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="New Task" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding TasksVM.NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,10,0" />

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding TasksVM.Categories}"
                                          SelectedItem="{Binding TasksVM.NewTaskCategory}"
                                          Height="32" Margin="0,0,10,0" />

                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding TasksVM.Priorities}"
                                          SelectedItem="{Binding TasksVM.NewTaskPriority}"
                                          Height="32" Margin="0,0,10,0" />

                                <TextBox Grid.Column="3"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding TasksVM.NewTaskDueDate, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding TasksVM.NewTaskDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Height="60"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding TasksVM.CloseCreatePanelCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Save Task"
                                        Style="{StaticResource ModernButton}"
                                        Command="{Binding TasksVM.CreateTaskCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Task List -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding TasksVM.Tasks}"
                             SelectedItem="{Binding TasksVM.SelectedTask}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSurface}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Completion Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding Completed, Mode=OneWay}"
                                                  Command="{Binding DataContext.TasksVM.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0" />

                                        <!-- Title & Meta -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Completed}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <!-- Badges -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <Border Background="#1E273A" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                            <Border Background="#1E273A" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Priority}" FontSize="11" Foreground="{StaticResource AccentAmber}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Delete Action -->
                                        <Button Grid.Column="3"
                                                Content="X"
                                                Style="{StaticResource DangerButton}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Command="{Binding DataContext.TasksVM.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ==================== NOTES VIEW ==================== -->
                <Grid Visibility="{Binding IsNotesTabActive, Converter={StaticResource BoolToVis}}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Action -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Actionable Notes" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        <Button Content="+ New Note"
                                Style="{StaticResource ModernButton}"
                                Command="{Binding NotesVM.OpenCreatePanelCommand}"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Inline Create Note Form -->
                    <Border Grid.Row="1"
                            Visibility="{Binding NotesVM.IsCreatePanelVisible, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Create New Note" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding NotesVM.NewNoteTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding NotesVM.NewNoteBody, UpdateSourceTrigger=PropertyChanged}"
                                     Height="80"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding NotesVM.CloseCreatePanelCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Save Note"
                                        Style="{StaticResource ModernButton}"
                                        Command="{Binding NotesVM.CreateNoteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Notes Split View -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Notes List -->
                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding NotesVM.Notes}"
                                 SelectedItem="{Binding NotesVM.SelectedNote}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="0,0,16,0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgSurface}"
                                            BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding Body}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected Note Editor -->
                        <Border Grid.Column="1"
                                Visibility="{Binding NotesVM.HasSelectedNote, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource BgSurface}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding NotesVM.SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="16"
                                         FontWeight="Bold"
                                         Margin="0,0,0,14" />

                                <TextBox Grid.Row="1"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding NotesVM.SelectedNote.Body, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Margin="0,0,0,14" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Delete Note"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding NotesVM.DeleteNoteCommand}"
                                            CommandParameter="{Binding NotesVM.SelectedNote}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Save Changes"
                                            Style="{StaticResource ModernButton}"
                                            Command="{Binding NotesVM.SaveSelectedNoteCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== BACKUP VIEW ==================== -->
                <ScrollViewer Visibility="{Binding IsBackupTabActive, Converter={StaticResource BoolToVis}}" Margin="24" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Data Backup &amp; Restore" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Export your offline database to portable universal JSON or restore from an existing TaskFlow backup."
                                       FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Notification banner -->
                        <Border Grid.Row="1"
                                Visibility="{Binding BackupVM.HasStatus, Converter={StaticResource BoolToVis}}"
                                Background="#064E3B"
                                BorderBrush="#059669"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,16">
                            <TextBlock Text="{Binding BackupVM.StatusMessage}" Foreground="#A7F3D0" FontSize="13" />
                        </Border>

                        <!-- Cards Grid -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Export Card -->
                            <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Export Backup" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Generate a complete JSON snapshot containing all tasks and notes."
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,14" />

                                    <Button Content="Generate Backup Export"
                                            Style="{StaticResource ModernButton}"
                                            Command="{Binding BackupVM.ExportBackupCommand}"
                                            Margin="0,0,0,14" />

                                    <TextBlock Text="Export Payload Preview:" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding BackupVM.ExportedJson, Mode=OneWay}"
                                             Height="240"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>

                            <!-- Restore Card -->
                            <Border Grid.Column="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Restore Backup" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Paste JSON backup data from web, mobile, or desktop exports."
                                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,14" />

                                    <!-- Mode Switcher -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Import Mode:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
                                        <Button Content="Merge"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding BackupVM.SetImportModeCommand}"
                                                CommandParameter="merge"
                                                Margin="0,0,6,0" />
                                        <Button Content="Replace"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding BackupVM.SetImportModeCommand}"
                                                CommandParameter="replace" />
                                    </StackPanel>

                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding BackupVM.ImportJsonText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="210"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,14" />

                                    <Button Content="Restore Data from Backup"
                                            Style="{StaticResource ModernButton}"
                                            Command="{Binding BackupVM.ImportBackupCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left" />
                <TextBlock Text="Offline SQLite Storage" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
