<Window x:Class="TaskFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskFlow"
        xmlns:vm="clr-namespace:TaskFlow.ViewModels"
        mc:Ignorable="d"
        Title="TaskFlow Desktop"
        Height="820" Width="1200"
        MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Dynamic Theme Color Palette -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0B0F19" />
        <SolidColorBrush x:Key="BgSurface" Color="#151C2C" />
        <SolidColorBrush x:Key="BgSurfaceElevated" Color="#1E273A" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#232E42" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentBlueHover" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="AccentRose" Color="#EF4444" />

        <!-- Styles -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="Foreground" Value="#FEE2E2" />
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource AccentGreen}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BgSurfaceElevated}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBlue}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateToTasksCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateToFollowUpsCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateToPlanMyDayCommand}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateToNotesCommand}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateToInboxCommand}" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateToCalendarCommand}" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateToAnalyticsCommand}" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateToBackupCommand}" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding NavigateToAccountCommand}" />
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{Binding NavigateToTasksCommand}" />
        <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding NavigateToFollowUpsCommand}" />
        <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding NavigateToPlanMyDayCommand}" />
        <KeyBinding Key="NumPad4" Modifiers="Control" Command="{Binding NavigateToNotesCommand}" />
        <KeyBinding Key="NumPad5" Modifiers="Control" Command="{Binding NavigateToInboxCommand}" />
        <KeyBinding Key="NumPad6" Modifiers="Control" Command="{Binding NavigateToCalendarCommand}" />
        <KeyBinding Key="NumPad7" Modifiers="Control" Command="{Binding NavigateToAnalyticsCommand}" />
        <KeyBinding Key="NumPad8" Modifiers="Control" Command="{Binding NavigateToBackupCommand}" />
        <KeyBinding Key="NumPad9" Modifiers="Control" Command="{Binding NavigateToAccountCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding QuickCreateCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Space" Command="{Binding ToggleSelectedCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TaskFlow" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" />
                    <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Windows" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </StackPanel>

                <!-- Global Search -->
                <Grid Grid.Column="1" HorizontalAlignment="Left" Width="440" Margin="10,0">
                    <TextBox x:Name="SearchInput"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,7"
                             AutomationProperties.Name="Global search input"
                             AutomationProperties.HelpText="Search across tasks, follow-ups, and notes" />
                    <TextBlock Text="Search tasks, commitments, notes (Ctrl+F)..."
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Actions: Sync, Theme and Quick Create -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Sync Status Indicator -->
                    <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding SyncStatusColor}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SyncStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Sync" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11" Command="{Binding SyncNowCommand}" AutomationProperties.Name="Trigger sync now" />
                        </StackPanel>
                    </Border>

                    <!-- Unresolved Conflicts Alert Button -->
                    <Button Content="Resolve Conflicts"
                            Style="{StaticResource DangerButton}"
                            Padding="8,4" FontSize="11" Margin="0,0,12,0"
                            Command="{Binding OpenConflictsCommand}"
                            Visibility="{Binding UnresolvedConflictsCount, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Open conflict resolution" />

                    <!-- Theme Selector -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Theme:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,6,0" />
                        <Button Content="Dark"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                Command="{Binding ThemeVM.SetThemeCommand}" CommandParameter="Dark"
                                AutomationProperties.Name="Dark theme" />
                        <Button Content="Light"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                Command="{Binding ThemeVM.SetThemeCommand}" CommandParameter="Light"
                                AutomationProperties.Name="Light theme" />
                        <Button Content="Contrast"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4" FontSize="11"
                                Command="{Binding ThemeVM.SetThemeCommand}" CommandParameter="HighContrast"
                                AutomationProperties.Name="High contrast theme" />
                    </StackPanel>

                    <Button Content="+ New Item"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding QuickCreateCommand}"
                            AutomationProperties.Name="Quick create new item"
                            AutomationProperties.HelpText="Create a new task, follow-up, or note depending on active tab" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="0">
                        <!-- 1. Tasks -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateToTasksCommand}" Margin="0,0,0,4" AutomationProperties.Name="Navigate to Tasks">
                            <Grid Width="180">
                                <TextBlock Text="Tasks" HorizontalAlignment="Left" />
                                <TextBlock Text="Ctrl+1" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <!-- 2. Follow Ups -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateToFollowUpsCommand}" Margin="0,0,0,4" AutomationProperties.Name="Navigate to Follow Ups">
                            <Grid Width="180">
                                <TextBlock Text="Follow Ups" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Visibility="{Binding FollowUpsVM.OpenCount, Converter={StaticResource BoolToVis}}" Background="{DynamicResource AccentBlue}" CornerRadius="10" Padding="6,1" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding FollowUpsVM.OpenCount}" FontSize="10" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="Ctrl+2" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- 3. Plan My Day -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateToPlanMyDayCommand}" Margin="0,0,0,4" AutomationProperties.Name="Navigate to Plan My Day">
                            <Grid Width="180">
                                <TextBlock Text="Plan My Day" HorizontalAlignment="Left" />
                                <TextBlock Text="Ctrl+3" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <!-- 4. Notes -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateToNotesCommand}" Margin="0,0,0,4" AutomationProperties.Name="Navigate to Notes">
                            <Grid Width="180">
                                <TextBlock Text="Notes" HorizontalAlignment="Left" />
                                <TextBlock Text="Ctrl+4" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <!-- 5. Fast Capture Inbox -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateToInboxCommand}" Margin="0,0,0,4" AutomationProperties.Name="Navigate to Fast Capture Inbox">
                            <Grid Width="180">
                                <TextBlock Text="Inbox" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Visibility="{Binding InboxVM.PendingCount, Converter={StaticResource BoolToVis}}" Background="{DynamicResource AccentAmber}" CornerRadius="10" Padding="6,1" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding InboxVM.PendingCount}" FontSize="10" Foreground="Black" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Text="Ctrl+5" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- 6. Calendar -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateToCalendarCommand}" Margin="0,0,0,4" AutomationProperties.Name="Navigate to Calendar">
                            <Grid Width="180">
                                <TextBlock Text="Calendar" HorizontalAlignment="Left" />
                                <TextBlock Text="Ctrl+6" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <!-- 7. Analytics -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateToAnalyticsCommand}" Margin="0,0,0,4" AutomationProperties.Name="Navigate to Analytics">
                            <Grid Width="180">
                                <TextBlock Text="Analytics" HorizontalAlignment="Left" />
                                <TextBlock Text="Ctrl+7" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <!-- 8. Backup & Restore -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateToBackupCommand}" Margin="0,0,0,4" AutomationProperties.Name="Navigate to Backup and Restore">
                            <Grid Width="180">
                                <TextBlock Text="Backup &amp; Restore" HorizontalAlignment="Left" />
                                <TextBlock Text="Ctrl+8" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <!-- 9. Account & Cloud Sync -->
                        <Button Style="{StaticResource SidebarButton}" Command="{Binding NavigateToAccountCommand}" Margin="0,0,0,4" AutomationProperties.Name="Navigate to Account and Cloud Sync">
                            <Grid Width="180">
                                <TextBlock Text="Account &amp; Sync" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="8" Height="8" Fill="{Binding SyncStatusColor}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="Ctrl+9" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Keyboard Help Box -->
                    <Border Grid.Row="2" Background="{DynamicResource BgSurfaceElevated}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                            <TextBlock Text="Ctrl+1..9: Switch tabs" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Ctrl+N: Quick create" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Ctrl+F: Focus search" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Space: Toggle complete" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,1" />
                            <TextBlock Text="Delete: Delete selected" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,1" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- WORK CONTENT CONTAINER -->
            <Grid Grid.Column="1" Background="{DynamicResource BgPrimary}">

                <!-- ==================== 1. TASKS VIEW ==================== -->
                <Grid Visibility="{Binding IsTasksTabActive, Converter={StaticResource BoolToVis}}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="All" Style="{StaticResource SecondaryButton}" Command="{Binding TasksVM.SetStatusFilterCommand}" CommandParameter="all" Margin="0,0,6,0" AutomationProperties.Name="Filter all tasks" />
                            <Button Content="Active" Style="{StaticResource SecondaryButton}" Command="{Binding TasksVM.SetStatusFilterCommand}" CommandParameter="active" Margin="0,0,6,0" AutomationProperties.Name="Filter active tasks" />
                            <Button Content="Completed" Style="{StaticResource SecondaryButton}" Command="{Binding TasksVM.SetStatusFilterCommand}" CommandParameter="completed" Margin="0,0,16,0" AutomationProperties.Name="Filter completed tasks" />

                            <TextBlock Text="Category:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding TasksVM.Categories}" SelectedItem="{Binding TasksVM.CategoryFilter}" Width="120" Height="32" AutomationProperties.Name="Filter task category" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="+ Add Task" Style="{StaticResource ModernButton}" Command="{Binding TasksVM.OpenCreatePanelCommand}" AutomationProperties.Name="Open Add Task panel" />
                    </Grid>

                    <!-- Create Task Form -->
                    <Border Grid.Row="1" Visibility="{Binding TasksVM.IsCreatePanelVisible, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="New Task" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Text="{Binding TasksVM.NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" AutomationProperties.Name="New task title" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TasksVM.Categories}" SelectedItem="{Binding TasksVM.NewTaskCategory}" Height="32" Margin="0,0,10,0" AutomationProperties.Name="New task category" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding TasksVM.Priorities}" SelectedItem="{Binding TasksVM.NewTaskPriority}" Height="32" Margin="0,0,10,0" AutomationProperties.Name="New task priority" />
                                <TextBox Grid.Column="3" Style="{StaticResource ModernTextBox}" Text="{Binding TasksVM.NewTaskDueDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New task due date" />
                            </Grid>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding TasksVM.NewTaskDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="New task description" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding TasksVM.CloseCreatePanelCommand}" Margin="0,0,8,0" AutomationProperties.Name="Cancel new task" />
                                <Button Content="Save Task" Style="{StaticResource ModernButton}" Command="{Binding TasksVM.CreateTaskCommand}" AutomationProperties.Name="Save new task" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tasks List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding TasksVM.Tasks}" SelectedItem="{Binding TasksVM.SelectedTask}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Tasks list">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Completed, Mode=OneWay}" Command="{Binding DataContext.TasksVM.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.Name="Toggle task completion" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Completed}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                            <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Priority}" FontSize="11" Foreground="{DynamicResource AccentAmber}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="3" Content="X" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="11" Command="{Binding DataContext.TasksVM.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" AutomationProperties.Name="Delete task" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ==================== 2. FOLLOW UPS VIEW ==================== -->
                <Grid Visibility="{Binding IsFollowUpsTabActive, Converter={StaticResource BoolToVis}}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Action Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Open" Style="{StaticResource SecondaryButton}" Command="{Binding FollowUpsVM.LoadCommand}" Margin="0,0,6,0" AutomationProperties.Name="Filter open follow ups" />
                            <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FollowUpsVM.OpenCount, StringFormat='Open: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <Border Background="#991B1B" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FollowUpsVM.OverdueCount, StringFormat='Overdue: {0}'}" FontSize="12" Foreground="White" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="2" Content="+ New Commitment" Style="{StaticResource ModernButton}" Command="{Binding FollowUpsVM.OpenCreatePanelCommand}" AutomationProperties.Name="Add new follow-up commitment" />
                    </Grid>

                    <!-- Create Follow-up Panel -->
                    <Border Grid.Row="1" Visibility="{Binding FollowUpsVM.IsCreatePanelVisible, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="New Follow-Up Commitment" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Text="{Binding FollowUpsVM.PersonName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" AutomationProperties.Name="Contact person name" />
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding FollowUpsVM.Commitment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" AutomationProperties.Name="Commitment details" />
                                <TextBox Grid.Column="2" Style="{StaticResource ModernTextBox}" Text="{Binding FollowUpsVM.DueAt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Commitment due date" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Text="{Binding FollowUpsVM.EmailAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" AutomationProperties.Name="Contact email address" />
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding FollowUpsVM.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" AutomationProperties.Name="Contact phone number" />
                                <TextBox Grid.Column="2" Style="{StaticResource ModernTextBox}" Text="{Binding FollowUpsVM.WhatsAppNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" AutomationProperties.Name="Contact WhatsApp number" />
                                <ComboBox Grid.Column="3" SelectedValuePath="Content" SelectedValue="{Binding FollowUpsVM.PreferredAction}" Height="32" AutomationProperties.Name="Preferred action">
                                    <ComboBoxItem Content="email" />
                                    <ComboBoxItem Content="phone" />
                                    <ComboBoxItem Content="whatsapp" />
                                </ComboBox>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding FollowUpsVM.ClosePanelsCommand}" Margin="0,0,8,0" AutomationProperties.Name="Cancel follow-up" />
                                <Button Content="Save Follow-Up" Style="{StaticResource ModernButton}" Command="{Binding FollowUpsVM.CreateCommand}" AutomationProperties.Name="Save follow-up" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Follow-ups List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding FollowUpsVM.FilteredFollowUps}" SelectedItem="{Binding FollowUpsVM.SelectedFollowUp}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Follow-ups list">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PersonName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" />
                                                <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PreferredAction}" FontSize="11" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Commitment}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,4" />
                                            <TextBlock Text="{Binding DueAt, StringFormat='Due: {0}'}" FontSize="11" Foreground="{DynamicResource AccentAmber}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Launch" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding DataContext.FollowUpsVM.LaunchPreferredActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Launch preferred communication action" />
                                            <Button Content="+24h Snooze" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding DataContext.FollowUpsVM.SnoozeCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Snooze follow-up 24 hours" />
                                            <Button Content="Complete" Style="{StaticResource SuccessButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding DataContext.FollowUpsVM.CompleteOccurrenceCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Complete follow-up occurrence" />
                                            <Button Content="X" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="11" Command="{Binding DataContext.FollowUpsVM.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Delete follow-up" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ==================== 3. PLAN MY DAY VIEW ==================== -->
                <Grid Visibility="{Binding IsPlanMyDayTabActive, Converter={StaticResource BoolToVis}}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Capacity Control Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Plan My Day Capacity Budgeting" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding PlanMyDayVM.StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,10" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Target Available Minutes:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" />
                                    <Button Content="1h (60m)" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0" Command="{Binding PlanMyDayVM.SetPresetCapacityCommand}" CommandParameter="60" />
                                    <Button Content="2h (120m)" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0" Command="{Binding PlanMyDayVM.SetPresetCapacityCommand}" CommandParameter="120" />
                                    <Button Content="4h (240m)" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0" Command="{Binding PlanMyDayVM.SetPresetCapacityCommand}" CommandParameter="240" />
                                    <Button Content="8h (480m)" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Command="{Binding PlanMyDayVM.SetPresetCapacityCommand}" CommandParameter="480" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Regenerate Plan" Style="{StaticResource SecondaryButton}" Command="{Binding PlanMyDayVM.GeneratePlanCommand}" Margin="0,0,8,0" AutomationProperties.Name="Regenerate plan" />
                                <Button Content="Accept Plan" Style="{StaticResource SuccessButton}" Command="{Binding PlanMyDayVM.AcceptPlanCommand}" AutomationProperties.Name="Accept plan for today" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Recommended & Overflow Grid -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <!-- Recommended Schedule -->
                        <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Recommended Plan Schedule" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding PlanMyDayVM.RecommendedItems}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Recommended day plan items">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,0,0,6" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="6" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" Command="{Binding DataContext.PlanMyDayVM.ToggleItemCompletedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Toggle plan item completed" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Explanation}" FontSize="11" Foreground="{DynamicResource AccentAmber}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{DynamicResource BgSurface}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock Text="{Binding EstimatedMinutes, StringFormat='{}{0}m'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                    </Border>
                                                    <Button Grid.Column="3" Content="Move" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" Command="{Binding DataContext.PlanMyDayVM.MoveToOverflowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" AutomationProperties.Name="Move item to overflow" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Overflow Backlog -->
                        <Border Grid.Column="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Overflow (Exceeding Capacity)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding PlanMyDayVM.OverflowItems}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Overflow items">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0,0,0,6" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="6" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding EstimatedMinutes, StringFormat='{}{0}m'}" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="+ Include" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" Command="{Binding DataContext.PlanMyDayVM.MoveToRecommendedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" AutomationProperties.Name="Include overflow item in plan" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== 4. NOTES VIEW (WITH NOTE READER & ACTIONABLE CONVERSION) ==================== -->
                <Grid Visibility="{Binding IsNotesTabActive, Converter={StaticResource BoolToVis}}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Action Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Actionable Notes &amp; Reader" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,14,0" />
                            <Button Content="{Binding NotesVM.IsReaderMode, ConverterParameter='Edit Mode', Converter={StaticResource BoolToVis}}" Style="{StaticResource SecondaryButton}" Command="{Binding NotesVM.ToggleReaderModeCommand}" Padding="8,4" FontSize="11" Margin="0,0,6,0" AutomationProperties.Name="Toggle reader mode" />
                            <Button Content="Copy Note Text" Style="{StaticResource SecondaryButton}" Command="{Binding NotesVM.CopyNoteBodyCommand}" Padding="8,4" FontSize="11" AutomationProperties.Name="Copy note text to clipboard" />
                        </StackPanel>

                        <Button Content="+ New Note" Style="{StaticResource ModernButton}" Command="{Binding NotesVM.OpenCreatePanelCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Open Create Note panel" />
                    </Grid>

                    <!-- Create Note Panel -->
                    <Border Grid.Row="1" Visibility="{Binding NotesVM.IsCreatePanelVisible, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Create New Note" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NotesVM.NewNoteTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="New note title" />
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NotesVM.NewNoteBody, UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="New note body" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding NotesVM.CloseCreatePanelCommand}" Margin="0,0,8,0" AutomationProperties.Name="Cancel note creation" />
                                <Button Content="Save Note" Style="{StaticResource ModernButton}" Command="{Binding NotesVM.CreateNoteCommand}" AutomationProperties.Name="Save new note" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Notes Split View -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Notes List -->
                        <ListBox Grid.Column="0" ItemsSource="{Binding NotesVM.Notes}" SelectedItem="{Binding NotesVM.SelectedNote}" Background="Transparent" BorderThickness="0" Margin="0,0,16,0" AutomationProperties.Name="Notes list">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,0,0,8" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding Body}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Note Editor & Reader Container -->
                        <Border Grid.Column="1" Visibility="{Binding NotesVM.HasSelectedNote, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Title and Metadata Bar -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NotesVM.SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="Bold" AutomationProperties.Name="Selected note title" />
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding NotesVM.WordCount, StringFormat='Words: {0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding NotesVM.ReadingTimeMinutes}" FontSize="11" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- Body / Reader Mode -->
                                <TextBox Grid.Row="2" Style="{StaticResource ModernTextBox}" Text="{Binding NotesVM.SelectedNote.Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,12" AutomationProperties.Name="Selected note body editor" />

                                <!-- Actionable Excerpt Extractor Bar -->
                                <Border Grid.Row="3" Background="{DynamicResource BgSurfaceElevated}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Actionable Excerpt (Convert to Task or Follow-Up)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Text="{Binding NotesVM.ActionableExcerpt, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" AutomationProperties.Name="Actionable excerpt text" />
                                            <Button Grid.Column="1" Content="+ Task" Style="{StaticResource SecondaryButton}" Command="{Binding NotesVM.CreateTaskFromExcerptCommand}" Margin="0,0,6,0" AutomationProperties.Name="Create task from excerpt" />
                                            <Button Grid.Column="2" Content="+ Follow-Up" Style="{StaticResource SecondaryButton}" Command="{Binding NotesVM.CreateFollowUpFromExcerptCommand}" AutomationProperties.Name="Create follow-up from excerpt" />
                                        </Grid>
                                        <TextBlock Text="{Binding NotesVM.ActionableSuccessMessage}" FontSize="11" Foreground="{DynamicResource AccentGreen}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Delete Note" Style="{StaticResource DangerButton}" Command="{Binding NotesVM.DeleteNoteCommand}" CommandParameter="{Binding NotesVM.SelectedNote}" Margin="0,0,8,0" AutomationProperties.Name="Delete note" />
                                    <Button Content="Save Changes" Style="{StaticResource ModernButton}" Command="{Binding NotesVM.SaveSelectedNoteCommand}" AutomationProperties.Name="Save note changes" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== 5. FAST CAPTURE INBOX VIEW ==================== -->
                <Grid Visibility="{Binding IsInboxTabActive, Converter={StaticResource BoolToVis}}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Quick Capture Header Box -->
                    <Border Grid.Row="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Fast Capture Inbox" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Text="{Binding InboxVM.FastCaptureText, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,10,0" AutomationProperties.Name="Fast capture text box" />
                                <Button Grid.Column="1" Content="Capture" Style="{StaticResource ModernButton}" Command="{Binding InboxVM.CaptureCommand}" AutomationProperties.Name="Execute fast capture" />
                            </Grid>
                            <TextBlock Text="Paste any text or URL. Links are automatically extracted and saved for 1-click triage." FontSize="11" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>

                    <!-- Captures List & Triage -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding InboxVM.FilteredCaptures}" SelectedItem="{Binding InboxVM.SelectedCapture}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Inbox captures list">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SharedUrl}" FontSize="12" Foreground="{DynamicResource AccentBlue}" TextDecorations="Underline" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding CapturedAt, StringFormat='Captured: {0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-> Task" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding DataContext.InboxVM.TriageToTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Triage capture to task" />
                                            <Button Content="-> Note" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding DataContext.InboxVM.TriageToNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Triage capture to note" />
                                            <Button Content="-> Follow-Up" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding DataContext.InboxVM.TriageToFollowUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Triage capture to follow-up" />
                                            <Button Content="Discard" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="11" Command="{Binding DataContext.InboxVM.DiscardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Discard capture" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ==================== 6. CALENDAR VIEW ==================== -->
                <Grid Visibility="{Binding IsCalendarTabActive, Converter={StaticResource BoolToVis}}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>

                    <!-- Calendar Month Nav -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="&lt;" Style="{StaticResource SecondaryButton}" Command="{Binding CalendarVM.PreviousMonthCommand}" Padding="10,4" Margin="0,0,6,0" AutomationProperties.Name="Previous month" />
                            <Button Content="&gt;" Style="{StaticResource SecondaryButton}" Command="{Binding CalendarVM.NextMonthCommand}" Padding="10,4" Margin="0,0,10,0" AutomationProperties.Name="Next month" />
                            <TextBlock Text="{Binding CalendarVM.MonthDisplay}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Today" Style="{StaticResource SecondaryButton}" Command="{Binding CalendarVM.TodayCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Jump to today" />
                    </Grid>

                    <!-- Monthly 42-cell UniformGrid -->
                    <Border Grid.Row="1" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,14">
                        <ItemsControl ItemsSource="{Binding CalendarVM.Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="6" Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.CalendarVM.SelectDateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="4">
                                        <Border CornerRadius="6" Background="{DynamicResource BgSurfaceElevated}" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding DayNumber}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                                <Border Grid.Row="1" Visibility="{Binding ItemCount, Converter={StaticResource BoolToVis}}" Background="{DynamicResource AccentBlue}" CornerRadius="4" Padding="4,1" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} due'}" FontSize="10" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Day Inspector -->
                    <Border Grid.Row="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding CalendarVM.SelectedDateDisplay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding CalendarVM.SelectedDayItems}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Selected day items">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="• " Foreground="{DynamicResource AccentBlue}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding Explanation, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== 7. ANALYTICS VIEW ==================== -->
                <ScrollViewer Visibility="{Binding IsAnalyticsTabActive, Converter={StaticResource BoolToVis}}" Margin="24" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Productivity Analytics &amp; Velocity" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding AnalyticsVM.RefreshCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Refresh analytics" />
                        </Grid>

                        <!-- KPI Cards Grid -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Completion Rate" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding AnalyticsVM.CompletionRate}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Total Tasks" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding AnalyticsVM.TotalTasks}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Overdue Tasks" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding AnalyticsVM.OverdueTasks}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentRose}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Open Follow-Ups" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding AnalyticsVM.OpenFollowUps}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentAmber}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Breakdown Cards -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Task Priority Distribution" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14" />
                                    <TextBlock Text="{Binding AnalyticsVM.HighPriorityTasks, StringFormat='High: {0}'}" FontSize="12" Foreground="{DynamicResource AccentRose}" Margin="0,0,0,4" />
                                    <ProgressBar Value="{Binding AnalyticsVM.HighPriorityPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource AccentRose}" Margin="0,0,0,12" />

                                    <TextBlock Text="{Binding AnalyticsVM.MediumPriorityTasks, StringFormat='Medium: {0}'}" FontSize="12" Foreground="{DynamicResource AccentAmber}" Margin="0,0,0,4" />
                                    <ProgressBar Value="{Binding AnalyticsVM.MediumPriorityPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource AccentAmber}" Margin="0,0,0,12" />

                                    <TextBlock Text="{Binding AnalyticsVM.LowPriorityTasks, StringFormat='Low: {0}'}" FontSize="12" Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,4" />
                                    <ProgressBar Value="{Binding AnalyticsVM.LowPriorityPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="{DynamicResource AccentBlue}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Entity Volume Breakdown" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,14" />
                                    <TextBlock Text="{Binding AnalyticsVM.TotalTasks, StringFormat='Total Tasks: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                                    <TextBlock Text="{Binding AnalyticsVM.TotalNotes, StringFormat='Actionable Notes: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                                    <TextBlock Text="{Binding AnalyticsVM.TotalFollowUps, StringFormat='Follow-Up Commitments: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                                    <TextBlock Text="{Binding AnalyticsVM.TotalCaptures, StringFormat='Fast Captures: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== 8. BACKUP VIEW ==================== -->
                <ScrollViewer Visibility="{Binding IsBackupTabActive, Converter={StaticResource BoolToVis}}" Margin="24" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Data Backup &amp; Restore" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Export your offline database to portable universal JSON or restore from an existing TaskFlow backup." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Notification banner -->
                        <Border Grid.Row="1" Visibility="{Binding BackupVM.HasStatus, Converter={StaticResource BoolToVis}}" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="{Binding BackupVM.StatusMessage}" Foreground="#A7F3D0" FontSize="13" />
                        </Border>

                        <!-- Cards Grid -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Export Backup" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Generate a complete JSON snapshot containing all tasks and notes." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,14" />
                                    <Button Content="Generate Backup Export" Style="{StaticResource ModernButton}" Command="{Binding BackupVM.ExportBackupCommand}" Margin="0,0,0,14" AutomationProperties.Name="Generate backup export" />
                                    <TextBlock Text="Export Payload Preview:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding BackupVM.ExportedJson, Mode=OneWay}" Height="240" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Export payload preview" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Restore Backup" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="Paste JSON backup data from web, mobile, or desktop exports." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,14" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Import Mode:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" />
                                        <Button Content="Merge" Style="{StaticResource SecondaryButton}" Command="{Binding BackupVM.SetImportModeCommand}" CommandParameter="merge" Margin="0,0,6,0" AutomationProperties.Name="Merge mode" />
                                        <Button Content="Replace" Style="{StaticResource SecondaryButton}" Command="{Binding BackupVM.SetImportModeCommand}" CommandParameter="replace" AutomationProperties.Name="Replace mode" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding BackupVM.ImportJsonText, UpdateSourceTrigger=PropertyChanged}" Height="210" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" AutomationProperties.Name="Import JSON payload text" />
                                    <Button Content="Restore Data from Backup" Style="{StaticResource ModernButton}" Command="{Binding BackupVM.ImportBackupCommand}" AutomationProperties.Name="Restore data from backup" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- ==================== 9. ACCOUNT & CLOUD SYNC VIEW ==================== -->
                <ScrollViewer Visibility="{Binding IsAccountTabActive, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Account &amp; Cloud Synchronization" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Sign in to sync your tasks, notes, follow-ups, and daily plans across your devices." FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Status & Error Banners -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <Border Visibility="{Binding AccountVM.ErrorMessage, Converter={StaticResource BoolToVis}}" Background="#7F1D1D" BorderBrush="{DynamicResource AccentRose}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <TextBlock Text="{Binding AccountVM.ErrorMessage}" Foreground="#FEE2E2" FontSize="13" />
                            </Border>
                            <Border Visibility="{Binding AccountVM.StatusMessage, Converter={StaticResource BoolToVis}}" Background="#064E3B" BorderBrush="{DynamicResource AccentGreen}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <TextBlock Text="{Binding AccountVM.StatusMessage}" Foreground="#A7F3D0" FontSize="13" />
                            </Border>
                            <!-- Adoption Prompt Banner -->
                            <Border Visibility="{Binding AccountVM.HasPendingAdoption, Converter={StaticResource BoolToVis}}" Background="#1E293B" BorderBrush="{DynamicResource AccentBlue}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Adopt Local Data" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" />
                                        <TextBlock Text="You have local tasks and notes created on this device. Would you like to upload and adopt them into your cloud account?" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Adopt Data" Style="{StaticResource ModernButton}" Command="{Binding AccountVM.AdoptDataCommand}" Margin="0,0,8,0" AutomationProperties.Name="Adopt local data into cloud account" />
                                        <Button Content="Dismiss" Style="{StaticResource SecondaryButton}" Command="{Binding AccountVM.DismissAdoptionCommand}" AutomationProperties.Name="Dismiss data adoption" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Content Cards -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Sign In or Profile -->
                            <StackPanel Grid.Column="0">
                                <!-- Signed-In Card -->
                                <Border Visibility="{Binding AccountVM.IsAuthenticated, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Current Account" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding AccountVM.UserEmail, StringFormat='Signed in as: {0}'}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,2" />
                                        <TextBlock Text="{Binding AccountVM.UserId, StringFormat='User ID: {0}'}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,14" />
                                        <Button Content="Sign Out" Style="{StaticResource DangerButton}" Command="{Binding AccountVM.LogoutCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Sign out of account" />
                                    </StackPanel>
                                </Border>

                                <!-- Unauthenticated Sign-In Card -->
                                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccountVM.IsAuthenticated}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Passwordless Sign In" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Enter your email to receive a secure 6-digit one-time passcode." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,14" />

                                        <!-- Email Step -->
                                        <StackPanel Visibility="{Binding AccountVM.IsOtpSent, Converter={StaticResource BoolToVis}}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccountVM.IsOtpSent}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Email Address:" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding AccountVM.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" AutomationProperties.Name="Sign in email address" />
                                            <Button Content="Send Verification Code" Style="{StaticResource ModernButton}" Command="{Binding AccountVM.RequestOtpCommand}" AutomationProperties.Name="Request verification code" />
                                        </StackPanel>

                                        <!-- OTP Step -->
                                        <StackPanel Visibility="{Binding AccountVM.IsOtpSent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding AccountVM.Email, StringFormat='Verification code sent to {0}:'}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding AccountVM.OtpCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Margin="0,0,0,12" AutomationProperties.Name="Enter 6-digit code" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Verify &amp; Sign In" Style="{StaticResource ModernButton}" Command="{Binding AccountVM.VerifyOtpCommand}" Margin="0,0,8,0" AutomationProperties.Name="Verify and sign in" />
                                                <Button Content="Change Email" Style="{StaticResource SecondaryButton}" Command="{Binding AccountVM.RequestOtpCommand}" AutomationProperties.Name="Change email" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Sync Health Card -->
                                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Cloud Synchronization Engine" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Protocol version 1 bidirectional sync with local SQLite cache." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,14" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="Status:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                            <Ellipse Width="8" Height="8" Fill="{Binding SyncStatusColor}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding SyncStatusText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Content="Sync Now" Style="{StaticResource ModernButton}" Command="{Binding SyncNowCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Manual sync now" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right Column: Active Sessions & Account Deletion -->
                            <StackPanel Grid.Column="2">
                                <!-- Active Sessions Card -->
                                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Active Devices &amp; Sessions" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Left" />
                                            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Command="{Binding AccountVM.RefreshSessionsCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Refresh active sessions" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding AccountVM.Sessions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BgSurfaceElevated}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding ClientPlatform}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                                                <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                                <TextBlock Text="{Binding CreatedAt, StringFormat='Active since: {0}'}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Revoke" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.AccountVM.RevokeSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" AutomationProperties.Name="Revoke session" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Danger Zone -->
                                <Border Visibility="{Binding AccountVM.IsAuthenticated, Converter={StaticResource BoolToVis}}" Background="#2A1215" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Danger Zone" FontSize="16" FontWeight="Bold" Foreground="#FCA5A5" />
                                        <TextBlock Text="Permanently delete your account and all associated cloud sync data." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,14" />
                                        <Button Content="Delete Account" Style="{StaticResource DangerButton}" Command="{Binding AccountVM.DeleteAccountCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Delete account permanently" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ==================== CONFLICT RESOLUTION MODAL OVERLAY ==================== -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding ConflictVM.IsOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource BgSurfaceElevated}" BorderBrush="{DynamicResource AccentAmber}" BorderThickness="1" CornerRadius="10" Padding="24" Width="720" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Sync Conflict Resolution" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentAmber}" HorizontalAlignment="Left" />
                            <Button Content="✕" Style="{StaticResource SecondaryButton}" Padding="8,4" Command="{Binding ConflictVM.CloseCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Close conflict modal" />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="A cloud revision differs from your local modification. Inspect the diff and choose which version to retain." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <!-- Side by Side Diff -->
                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Local Card -->
                            <Border Grid.Column="0" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Local Modification (This Device)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,8" />
                                    <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding ConflictVM.LocalSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Server Card -->
                            <Border Grid.Column="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Server Revision (Cloud)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentAmber}" Margin="0,0,0,8" />
                                    <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding ConflictVM.ServerSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Actions -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Keep Local Version" Style="{StaticResource ModernButton}" Command="{Binding ConflictVM.KeepLocalCommand}" Margin="0,0,10,0" AutomationProperties.Name="Keep local version and re-upload" />
                            <Button Content="Keep Server Version" Style="{StaticResource SecondaryButton}" Command="{Binding ConflictVM.KeepServerCommand}" Margin="0,0,10,0" AutomationProperties.Name="Accept server version" />
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding ConflictVM.CloseCommand}" AutomationProperties.Name="Cancel conflict resolution" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left" />
                <TextBlock Text="Offline SQLite Storage" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
