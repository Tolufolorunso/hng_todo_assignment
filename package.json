{
  "name": "taskflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "test": "npm --prefix apps/web run test",
    "verify": "npm run check:boundaries && npm --prefix apps/web run lint && npm --prefix apps/web run test && npm --prefix apps/web run build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:migrate": "npm --prefix apps/web run db:migrate"
  }
}
